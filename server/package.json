{
  "name": "floetende-kroeten-server",
  "version": "1.0.0",
  "description": "PC server for the Floetende Kroeten RFID game: serial bridge to the gateway, SQLite DB and web dashboard",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch-path=src src/index.js",
    "sim": "node --watch-path=src src/index.js --sim",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "express": "^4.22.3",
    "serialport": "12.0.0",
    "ws": "^8.23.0"
  }
}
